<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F111A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Greeting Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#161824"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Welcome back, User! 👋"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready to crush your goals today?"
                android:textColor="#A0A0A0"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Metric Cards Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#161824"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Study Hours"
                    android:textColor="#A0A0A0"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.5h / 6h"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#161824"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Tasks Streak"
                    android:textColor="#A0A0A0"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 5 Days"
                    android:textColor="#FFB74D"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Quick Modules"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_to_planner"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#7C4DFF"
            android:text="📅 Study Planner"
            android:textColor="#FFFFFF"
            android:textAlignment="textStart"
            android:paddingStart="20dp" />

        <Button
            android:id="@+id/btn_to_flashcards"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#161824"
            android:text="🃏 Flashcards Generator"
            android:textColor="#FFFFFF"
            android:textAlignment="textStart"
            android:paddingStart="20dp" />

        <Button
            android:id="@+id/btn_to_resume"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#161824"
            android:text="📄 AI Resume Builder"
            android:textColor="#FFFFFF"
            android:textAlignment="textStart"
            android:paddingStart="20dp" />

        <Button
            android:id="@+id/btn_to_scanner"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#161824"
            android:text="📷 Document Scanner &amp; OCR"
            android:textColor="#FFFFFF"
            android:textAlignment="textStart"
            android:paddingStart="20dp" />

        <Button
            android:id="@+id/btn_to_interview"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#161824"
            android:text="🎤 Interview Simulator"
            android:textColor="#FFFFFF"
            android:textAlignment="textStart"
            android:paddingStart="20dp" />

        <Button
            android:id="@+id/btn_to_summarizer"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#161824"
            android:text="📚 Note Summarizer"
            android:textColor="#FFFFFF"
            android:textAlignment="textStart"
            android:paddingStart="20dp" />
    </LinearLayout>
</ScrollView>
